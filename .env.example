# ============================================================
# Platinum v3.1 — GLOBAL APP SETTINGS
#
# This is the one place to configure every module's connection strings,
# shared secrets, and external API URLs for local development. Copy this
# file to `.env` (gitignored) and fill in real values.
#
# Every module below reads its own settings FROM THIS FILE (Node modules via
# `dotenv`, .NET modules via a small loader in each Program.cs — both use
# "existing environment variable wins", so an App Setting or real OS env var
# always takes priority over what's in here). Each module's own config file
# (appsettings.json, config/app.js, environment.ts) has a comment pointing
# back here — this file is the source of truth, not those.
#
# NEVER commit the real `.env` file to git.
# ============================================================


# ------------------------------------------------------------
# GLOBAL AUTH — shared by every module
# ------------------------------------------------------------
# The HS256 secret POS-API signs the global identity JWT with (see
# POS-API/ems-jwt.ts) and every migrated module verifies with. MUST be the
# exact same value across POS-API, SCM-API, OVERTIME-API, PAYROLL-APP, and
# Insight-Performance-Hub/artifacts/api-server, or a token minted by one
# won't verify at another. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PLATINUM_JWT_SECRET=change-this-to-a-long-random-string-shared-by-every-service

# POS-API's express-session cookie secret (min 32 random chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars


# ------------------------------------------------------------
# ASSETS — Postgres backend (ASSETS-PSQL-API, default backend)
# ------------------------------------------------------------
# Read directly by ASSETS-PSQL-API/Data/DbConnectionFactory.cs.
# Also aliased as POSTGRES_URL for the same value (Replit-era name, kept for
# back-compat — set both to the same connection string).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/platinum
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/platinum
# SQL Server variant (ASSETS-API, database "test02" in the deployed
# environment) — connection string location not wired to this file yet;
# check ASSETS-API's own config before assuming it reads this.

# ------------------------------------------------------------
# BUDGET — Postgres backend (BUDGET-APP/PlatinumBudget.Api)
# ------------------------------------------------------------
# Checked BEFORE the generic DATABASE_URL above, specifically so this module
# never accidentally picks up Assets' database when both are loaded from
# this same shared file. Falls back to ConnectionStrings:BudgetDb in
# appsettings if unset (see BUDGET-APP/PlatinumBudget.Api/Program.cs).
BUDGET_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/budget

# ------------------------------------------------------------
# OVERTIME — .NET, dual-provider (OVERTIME-API)
# ------------------------------------------------------------
# Production uses Postgres ("Overtime" database) — genuinely separate from
# the EMS_GeorgeUAT SQL Server database below, confirmed live. Checked
# BEFORE the generic DATABASE_URL for the same collision-avoidance reason
# as Budget above. Falls back to ConnectionStrings:OvertimeDb in appsettings
# if unset (see OVERTIME-API/Program.cs).
OVERTIME_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/overtime

# ------------------------------------------------------------
# IDP — .NET (IDP-UI/PlatinumIDP)
# ------------------------------------------------------------
# Same collision-avoidance pattern — checked before the generic DATABASE_URL.
# Accepts either a postgresql:// URL or a raw SQL Server connection string.
IDP_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/idp

# ------------------------------------------------------------
# AFS — Node/Express (AFS-UI/api), separate "AFS" Postgres database
# ------------------------------------------------------------
AZURE_POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/afs
# ART source-system API, proxied at /api/art/*. Basic-auth — set USER/PASS to enable.
ART_API_URL=https://your-art-api-host
ART_API_USER=
ART_API_PASS=
# Platinum core financials API (trial-balance / general-ledger), proxied at /api/platinum/*.
# Named AFS_PLATINUM_API_URL (NOT PLATINUM_API_URL) deliberately — POS-API has its own
# PLATINUM_API_URL meaning a different backend (George's billing/auth API); a shared name
# here would shadow POS-API's real value if POS-API ever loads this file.
AFS_PLATINUM_API_URL=https://your-afs-financials-host

# ------------------------------------------------------------
# PAYROLL — Node/Express (PAYROLL-APP), separate "Payroll" Postgres database
# ------------------------------------------------------------
AZURE_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/payroll
# Payroll's own JWT config key — PLATINUM_JWT_SECRET above takes priority;
# this is only a fallback name, kept for back-compat.
JWT_SECRET=change-this-to-the-same-value-as-PLATINUM_JWT_SECRET
# Explicit opt-in to Payroll's old dev-only X-User-Id header shortcut.
# Leave unset — never enable in anything resembling production.
PAYROLL_ALLOW_DEV_HEADER_AUTH=

# ------------------------------------------------------------
# PERFORMANCE — Node/Express, pnpm workspace (Insight-Performance-Hub/artifacts/api-server)
# ------------------------------------------------------------
APP_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/performance
# Explicit opt-in to Performance's old unsigned x-user header fallback.
# Leave unset — never enable in anything resembling production.
PERF_ALLOW_LEGACY_HEADER_AUTH=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=

# ------------------------------------------------------------
# SCM — .NET (SCM-API), SQL Server EMS_GeorgeUAT
# ------------------------------------------------------------
# Bound automatically into ConnectionStrings:DefaultConnection by ASP.NET
# Core's built-in environment-variable configuration provider (the "__"
# double underscore maps to ":") — no code change needed for this one to
# take effect, just a real value here.
ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=EMS_GeorgeUAT;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# ------------------------------------------------------------
# Node environment (all Node modules)
# ------------------------------------------------------------
NODE_ENV=development
